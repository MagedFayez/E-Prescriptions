<Window x:Class="ePrescriptions.App.Views.StandaloneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ePrescriptions.App.ViewModels"
        xmlns:views="clr-namespace:ePrescriptions.App.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="780" Width="1240"
        MinHeight="540" MinWidth="850"
        WindowState="Normal"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{StaticResource AppBackgroundGradient}">

    <!-- تعيين DataTemplates لربط كل ViewModel بـ View الخاصة به داخل النافذة المنفصلة -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate DataType="{x:Type vm:SalesViewModel}">
            <views:SalesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PurchasesViewModel}">
            <views:PurchasesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SupplierReturnsViewModel}">
            <views:SupplierReturnsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PurchaseOrdersViewModel}">
            <views:PurchaseOrdersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StocktakeViewModel}">
            <views:StocktakeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PriceListImportViewModel}">
            <views:PriceListImportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomersViewModel}">
            <views:CustomersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FinanceViewModel}">
            <views:FinanceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StaffViewModel}">
            <views:StaffView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ZakatViewModel}">
            <views:ZakatView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HelpViewModel}">
            <views:HelpView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OwnerLogViewModel}">
            <views:OwnerLogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StaffAuditLogViewModel}">
            <views:StaffAuditLogView />
        </DataTemplate>
    </Window.Resources>

    <!-- اختصارات لوحة المفاتيح العامة (F1..F10) إذا كانت الشاشة المعروضة شاشة مبيعات -->
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding CurrentViewModel.NewInvoiceCommand}" />
        <KeyBinding Key="F2" Command="{Binding CurrentViewModel.SaveInvoiceCommand}" />
        <KeyBinding Key="F3" Command="{Binding CurrentViewModel.PrintInvoiceCommand}" />
        <KeyBinding Key="F8" Command="{Binding CurrentViewModel.SuspendInvoiceCommand}" />
        <KeyBinding Key="F9" Command="{Binding CurrentViewModel.ToggleReturnModeCommand}" />
        <KeyBinding Key="F10" Command="{Binding CurrentViewModel.OpenCashDrawerCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <!-- الشريط العلوي الخاص بالنافذة المنفصلة -->
            <RowDefinition Height="50" />
            <!-- المحتوى الكامل للشاشة -->
            <RowDefinition Height="*" />
            <!-- الفوتر الثابت -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1) شريط العنوان والهوية للنافذة المستقلة -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" BorderBrush="{StaticResource BrandStripeGradient}" BorderThickness="0,0,0,3" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White" CornerRadius="8" Width="32" Height="32" Margin="0,0,10,0">
                        <Path Data="{StaticResource IconSales}" Fill="#0083CB" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding WindowTitle}" Foreground="White" FontWeight="Bold" FontSize="14" />
                        <TextBlock Text="نافذة مستقلة تدعم الشاشات المتعددة (Multi-Monitor)" Foreground="#DCF1FB" FontSize="10" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#26FFFFFF" CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                        <TextBlock Text="e_prescriptions" Foreground="White" FontWeight="Bold" FontSize="11" />
                    </Border>
                    <Button Click="CloseButton_Click" Background="#FFE4EE" BorderThickness="0" Cursor="Hand" Padding="12,5">
                        <TextBlock Text="إغلاق النافذة" Foreground="#A2165F" FontSize="11" FontWeight="SemiBold" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2) منطقة عرض الشاشة -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" Margin="6" />

        <!-- 3) الفوتر -->
        <Border Grid.Row="2" Background="White" BorderBrush="#D5E4EE" BorderThickness="0,1,0,0" Padding="8,4">
            <TextBlock Text="E-Prescriptions by Maged Fayez | (C) all rights reserved" FlowDirection="LeftToRight"
                       Foreground="#5B7389" FontSize="11" HorizontalAlignment="Center" />
        </Border>
    </Grid>
</Window>
